# ── Claude API ──────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Notion ──────────────────────────────────────────────────
# Integration Token: https://www.notion.so/my-integrations
NOTION_TOKEN=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Daily 분석 결과를 저장할 DB 페이지 ID (URL에서 마지막 32자리 hex)
NOTION_DAILY_DB_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Weekly 보고서를 저장할 DB 페이지 ID
NOTION_WEEKLY_DB_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Gmail ────────────────────────────────────────────────────
# 발신 Gmail 주소
GMAIL_ADDRESS=your_address@gmail.com
# Google 계정 → 보안 → 앱 비밀번호 (16자리)
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
# 수신 이메일 (쉼표로 여러 개 가능)
RECIPIENT_EMAILS=rich.h16@gmail.com

# ── 분석 설정 ────────────────────────────────────────────────
# 사용할 Claude 모델
CLAUDE_MODEL=claude-sonnet-4-6
# 분석 언어 (ko / en)
ANALYSIS_LANGUAGE=ko
