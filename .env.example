# ══════════════════════════════════════════════════════════════
# LLM APIs — 폴백 순서: Claude → Gemini → GPT → DeepSeek → Groq → Mistral
# 하나 이상 입력하면 자동 폴백됩니다. 없는 키는 비워두세요.
# ══════════════════════════════════════════════════════════════

# 1. Claude (Anthropic) — 유료 | https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 2. Gemini (Google) — 무료 티어 1,500회/일 | https://aistudio.google.com
GEMINI_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 3. GPT (OpenAI) — 유료 | https://platform.openai.com
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 4. DeepSeek — 사실상 무료 ($0.014/1M 토큰) | https://platform.deepseek.com
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 5. Groq — 무료 14,400회/일 (LLaMA 3.3 70B) | https://console.groq.com
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 6. Mistral — 무료 티어 | https://console.mistral.ai
MISTRAL_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ══════════════════════════════════════════════════════════════
# 모델 선택 (기본값 사용 권장 — 변경 시만 입력)
# ══════════════════════════════════════════════════════════════
# CLAUDE_MODEL=claude-sonnet-4-6
# GEMINI_MODEL=gemini-2.0-flash
# OPENAI_MODEL=gpt-4o
# DEEPSEEK_MODEL=deepseek-chat
# GROQ_MODEL=llama-3.3-70b-versatile
# MISTRAL_MODEL=mistral-large-latest

# ══════════════════════════════════════════════════════════════
# Notion
# ══════════════════════════════════════════════════════════════
NOTION_TOKEN=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
NOTION_DAILY_DB_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NOTION_WEEKLY_DB_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ══════════════════════════════════════════════════════════════
# Gmail
# ══════════════════════════════════════════════════════════════
GMAIL_ADDRESS=your_address@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
RECIPIENT_EMAILS=rich.h16@gmail.com

# ══════════════════════════════════════════════════════════════
# PPT 템플릿 설정 (templates/ 폴더에 .pptx 파일을 넣은 경우)
# ══════════════════════════════════════════════════════════════
TEMPLATE_PATH=templates/report_template.pptx
TEMPLATE_TITLE_LAYOUT=0     # 표지 슬라이드 레이아웃 번호 (inspect_template.py로 확인)
TEMPLATE_CONTENT_LAYOUT=1   # 내용 슬라이드 레이아웃 번호
TEMPLATE_TITLE_PH=0         # 제목 플레이스홀더 idx
TEMPLATE_BODY_PH=1          # 본문 플레이스홀더 idx

# ══════════════════════════════════════════════════════════════
# 기타
# ══════════════════════════════════════════════════════════════
PPT_OUTPUT_DIR=/tmp
